{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint bin lib --max-warnings=0",
    "lint:fix": "eslint bin lib --fix",
    "cdk": "cdk",
    "synth": "yarn cdk synth",
    "diff": "yarn cdk diff",
    "deploy": "yarn cdk deploy"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "aws-cdk": "^2.1138.0",
    "ts-node": "^10.9.1"
  },
  "dependencies": {
    "aws-cdk-lib": "2.266.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  }
}
